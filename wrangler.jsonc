{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiligaynon101",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
